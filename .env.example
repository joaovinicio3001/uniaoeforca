# ============================================================
# União & Força — variáveis de ambiente (doc §34.8)
# Copie para .env.local e preencha. NUNCA versione .env.local.
# ============================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase (projeto: uniao-e-forca / qmpsranxguyxxbplvcjf) ---
NEXT_PUBLIC_SUPABASE_URL=https://qmpsranxguyxxbplvcjf.supabase.co
# Chave publicável moderna (recomendada) OU a legacy anon key. O client aceita as duas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# EXCLUSIVA DO SERVIDOR. Nunca enviar ao browser. Pegue em:
# Supabase Dashboard > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# --- Bunny.net (Storage + CDN de imagens de campanha) ---
# Sem as 3 primeiras, o upload cai no Supabase Storage automaticamente.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_URL=https://SUA-ZONA.b-cdn.net
# Só se a Storage Zone não for a região padrão. Ex.: br.storage.bunnycdn.com (São Paulo).
BUNNY_STORAGE_HOST=storage.bunnycdn.com

# --- Pushin Pay (PIX In — Fase 2) ---
# API key no formato "id|hash". O Pushin Pay NÃO documenta assinatura de webhook:
# o WEBHOOK_SECRET abaixo é só um token no path da URL de webhook (defesa extra);
# a confirmação real é sempre por GET /transactions/{id} autenticado.
PUSHINPAY_API_KEY=
PUSHINPAY_WEBHOOK_SECRET=
# Vazio = sandbox em dev / produção quando NODE_ENV=production.
# Fixe em https://api.pushinpay.com.br/api se o token for de produção.
PUSHINPAY_BASE_URL=
# Custo do provedor de PIX In (Pushin Pay): tarifa fixa R$ 0,35, sem % (§9).
PUSHINPAY_FEE_BPS=0
PUSHINPAY_FEE_MIN_CENTS=35

# --- GGPix (PIX Out — Fase 4) ---
# Sem GGPIX_API_KEY o app usa um provedor MOCK (admin simula o desfecho).
# IP whitelist é OBRIGATÓRIO no painel da GGPix para o PIX Out funcionar.
# Webhook sem assinatura documentada → secret é só token no path.
GGPIX_API_KEY=
GGPIX_WEBHOOK_SECRET=
# Vazio = https://ggpixapi.com/api/v1 (contingência: https://ggatepixapi.com/api/v1)
GGPIX_BASE_URL=
# Proxy de saída (Fixie) — só as chamadas à GGPix passam por ele, para saírem de
# um IP estático whitelistado no painel da GGPix. Ex.: http://fixie:SENHA@velodrome.usefixie.com:80
FIXIE_URL=
# auto (default) | mock | ggpix — força o provedor de PIX Out (mock não dispara nada real).
PIXOUT_PROVIDER=auto

# --- Segredos de aplicação ---
# Pepper do hash de CPF (doc §18). >=16 chars, estável para sempre (mudar orfana
# os CPFs já gravados). Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CPF_HASH_PEPPER=
# AES-256 (64 hex) para cifrar valores de chave PIX em repouso. Estável para
# sempre (rotação exige recifrar pix_keys). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENC_KEY=

# --- Limites de saque (centavos) ---
WITHDRAWAL_MIN_CENTS=2000
WITHDRAWAL_MAX_CENTS=500000000
WITHDRAWAL_DAILY_MAX_CENTS=200000000
WITHDRAWAL_PIX_KEY_COOLDOWN_HOURS=24
# Acima disso o saque exige KYC reforçado; e acima do 2º, dupla aprovação (§14).
KYC_ENHANCED_THRESHOLD_CENTS=200000
WITHDRAWAL_HIGH_VALUE_CENTS=500000

# --- Observabilidade (Fase 0+; opcional em dev) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- E-mail transacional (Resend — Fase 5) ---
# Sem RESEND_API_KEY, o envio de e-mail é no-op (a notificação in-app é a fonte primária).
RESEND_API_KEY=
EMAIL_FROM="União & Força <nao-responda@uniaoeforca.com.br>"

# --- Jobs agendados (Vercel Cron — Fase 6) ---
# A Vercel injeta este valor como "Authorization: Bearer <CRON_SECRET>" nas rotas /api/cron/*.
# Gere: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
